<!DOCTYPE html>
<html lang="th">
<head>
  <meta charset="UTF-8">
  <base target="_top">
  <title>ระบบสแกน QR Code เช็คอินเข้างาน</title>
  <meta name="viewport" content="width=device-width, initial-scale=1.0, viewport-fit=cover">
  <script src="https://unpkg.com/html5-qrcode@2.3.8/html5-qrcode.min.js"></script>
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'Prompt', Arial, sans-serif;
      background: #f4f6f9;
      margin: 0;
      padding: 20px;
      display: flex;
      justify-content: center;
    }
    .card {
      width: 100%;
      max-width: 480px;
      background: #fff;
      padding: 24px;
      border-radius: 12px;
      box-shadow: 0 4px 15px rgba(0,0,0,.10);
      text-align: center;
    }
    h2 { margin: 0 0 8px; color: #2c3e50; }
    p { color: #4f5b66; font-size: 14px; }
    .actions, .manual-input {
      display: flex;
      gap: 10px;
      margin-top: 14px;
      flex-wrap: wrap;
    }
    button, .file-label {
      border: 0;
      border-radius: 7px;
      padding: 11px 14px;
      font-size: 15px;
      font-weight: 500;
      cursor: pointer;
    }
    .primary { background: #2563eb; color: #fff; }
    .secondary { background: #059669; color: #fff; }
    .file-label { background: #e2e8f0; color: #1e293b; text-align: center; }
    .actions > * { flex: 1 1 180px; }
    #qrImage, #fileReader { display: none; }
    .manual-input input {
      flex: 1;
      min-width: 0;
      padding: 11px;
      border: 1px solid #cbd5e1;
      border-radius: 7px;
      font-size: 15px;
    }
    button:disabled, input:disabled { opacity: .65; cursor: not-allowed; }
    #status {
      display: none;
      margin-top: 16px;
      padding: 12px;
      border-radius: 8px;
      font-weight: 600;
      line-height: 1.45;
      word-break: break-word;
    }
    .info { background: #e0f2fe; color: #0369a1; border: 1px solid #bae6fd; }
    .success { background: #dcfce7; color: #15803d; border: 1px solid #bbf7d0; }
    .already { background: #fef3c7; color: #b45309; border: 1px solid #fde68a; }
    .error { background: #fee2e2; color: #b91c1c; border: 1px solid #fca5a5; }
  </style>
</head>
<body>
  <div class="card">
    <h2>สแกน QR Code เช็คอิน</h2>
    <p>สแกนด้วยกล้อง รูปภาพ หรือกรอกรหัสลงทะเบียน</p>

    <div class="actions">
      <button id="openScannerBtn" class="primary" type="button">เปิดกล้องสแกน QR</button>
      <label class="file-label" for="qrImage">เลือกรูป QR Code</label>
      <input id="qrImage" type="file" accept="image/*">
    </div>

    <div id="fileReader"></div>

    <div class="manual-input">
      <input id="regIdInput" type="text" placeholder="กรอกรหัส REG-xxx" autocomplete="off">
      <button id="submitBtn" class="secondary" type="button">ส่งข้อมูล</button>
    </div>

    <div id="status"></div>
  </div>

  <script>
    const CAMERA_URL = "https://kittipat-aupalee.github.io/TPAT2027/";
    // รับค่า Web App URL โดยตรงจาก Google Apps Script
    const WEB_APP_URL = "<?= webAppUrl ?>";
    const PARAM_SCAN = "<?= scanValue ?>";

    let isProcessing = false;

    const openScannerBtn = document.getElementById("openScannerBtn");
    const qrImage = document.getElementById("qrImage");
    const regIdInput = document.getElementById("regIdInput");
    const submitBtn = document.getElementById("submitBtn");
    const imageQrReader = new Html5Qrcode("fileReader");

    function normalizeRegId(value) {
      return String(value || "").trim();
    }

    function showStatus(message, type) {
      const el = document.getElementById("status");
      el.textContent = message;
      el.className = type;
      el.style.display = "block";
    }

    function setFormEnabled(enabled) {
      openScannerBtn.disabled = !enabled;
      regIdInput.disabled = !enabled;
      submitBtn.disabled = !enabled;
    }

    function finishProcessing(delay = 1200) {
      setTimeout(() => {
        isProcessing = false;
        setFormEnabled(true);
      }, delay);
    }

    // เปิดหน้ากล้องสแกนโดยส่ง returnUrl ที่ถูกต้องแน่นอน
    function openExternalScanner() {
      if (!WEB_APP_URL) {
        showStatus("ไม่พบ URL ของ Web App", "error");
        return;
      }
      
      const targetScannerUrl = new URL(CAMERA_URL);
      targetScannerUrl.searchParams.set("returnUrl", WEB_APP_URL);
      
      // เปิดข้ามไปหน้าสแกนภายนอกแบบเต็มหน้าจอ
      window.open(targetScannerUrl.toString(), "_top");
    }

    // ประมวลผลรหัสเพื่อเช็คอิน
    function processRegistration(rawValue) {
      const regId = normalizeRegId(rawValue);
      if (!regId || isProcessing) return;

      isProcessing = true;
      setFormEnabled(false);
      showStatus("กำลังตรวจสอบข้อมูล...", "info");

      google.script.run
        .withSuccessHandler(handleResponse)
        .withFailureHandler(handleServerError)
        .processCheckIn(regId);
    }

    function handleResponse(res) {
      if (!res || typeof res !== "object") {
        handleServerError(new Error("รูปแบบการตอบกลับจากเซิร์ฟเวอร์ไม่ถูกต้อง"));
        return;
      }

      if (res.success) {
        showStatus(res.message || "เช็คอินสำเร็จ", "success");
        regIdInput.value = "";
      } else if (res.status === "already") {
        showStatus(res.message || "รายการนี้เช็คอินแล้ว", "already");
      } else {
        showStatus(res.message || "ไม่พบข้อมูลรหัสลงทะเบียนนี้", "error");
      }

      finishProcessing();
    }

    function handleServerError(error) {
      const message = error && error.message ? error.message : String(error || "Unknown error");
      showStatus("เกิดข้อผิดพลาด: " + message, "error");
      finishProcessing();
    }

    // สแกนจากรูปภาพ
    async function scanImage(file) {
      if (!file || isProcessing) return;

      try {
        showStatus("กำลังอ่าน QR Code จากรูปภาพ...", "info");
        const decodedText = await imageQrReader.scanFile(file, true);
        processRegistration(decodedText);
      } catch (_) {
        showStatus("ไม่พบ QR Code ในรูปภาพ กรุณาใช้รูปที่ชัดเจน", "error");
      } finally {
        qrImage.value = "";
      }
    }

    function submitManual() {
      const regId = normalizeRegId(regIdInput.value);
      if (!regId) {
        showStatus("กรุณากรอกรหัสลงทะเบียน", "error");
        regIdInput.focus();
        return;
      }
      processRegistration(regId);
    }

    // ตรวจสอบค่าที่สแกนกลับมาจาก URL Parameter (?scan=...)
    function checkUrlScanParameter() {
      if (PARAM_SCAN) {
        processRegistration(PARAM_SCAN);
      } else if (google && google.script && google.script.url && google.script.url.getLocation) {
        google.script.url.getLocation(function(location) {
          const scan = location && location.parameter && normalizeRegId(location.parameter.scan);
          if (scan) {
            processRegistration(scan);
          }
        });
      }
    }

    openScannerBtn.addEventListener("click", openExternalScanner);
    qrImage.addEventListener("change", function() { scanImage(this.files && this.files[0]); });
    submitBtn.addEventListener("click", submitManual);
    regIdInput.addEventListener("keydown", function(e) { if (e.key === "Enter") submitManual(); });

    window.addEventListener("load", checkUrlScanParameter);
  </script>
</body>
</html>
